# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development with docker compose.

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Bootstrap server(s) for producers and consumers on the host machine.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic where audit events are published.
KAFKA_TOPIC=audit.events

# Consumer group ID.
KAFKA_CONSUMER_GROUP_ID=audit-pipeline

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full connection string used by psycopg.
POSTGRES_DSN=postgresql://audit:audit@localhost:5432/audit

# ── Application ───────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
